<mxfile host="app.diagrams.net"><diagram id="COLORS Activity Diagram" name="COLORS Activity Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_user" value="User" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="250" height="1700" as="geometry"/></mxCell><mxCell id="lane_br" value="Browser (code.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="20" width="250" height="1700" as="geometry"/></mxCell><mxCell id="lane_srv" value="Server (PHP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="250" height="1700" as="geometry"/></mxCell><mxCell id="lane_db" value="MySQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="20" width="250" height="1700" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="70" width="30" height="30" as="geometry"/></mxCell><mxCell id="a1" value="Open index.html, enter login and password, click &amp;quot;Do It&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="210" height="60" as="geometry"/></mxCell><mxCell id="a2" value="doLogin(): read #loginName and #loginPassword, POST {login, password} to Login.php" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="210" width="210" height="70" as="geometry"/></mxCell><mxCell id="a3" value="Login.php: parse JSON request, connect with db_config.php" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="540" y="310" width="210" height="50" as="geometry"/></mxCell><mxCell id="a4" value="SELECT ID, firstName, lastName FROM Users WHERE Login=? AND Password=?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="790" y="400" width="210" height="80" as="geometry"/></mxCell><mxCell id="d1" value="Row found?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="555" y="520" width="180" height="80" as="geometry"/></mxCell><mxCell id="err" value="Response id = 0 (&amp;quot;No Records Found&amp;quot;): show &amp;quot;User/Password combination incorrect&amp;quot; in #loginResult" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="515" width="210" height="90" as="geometry"/></mxCell><mxCell id="end1" value="" style="shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="545" width="30" height="30" as="geometry"/></mxCell><mxCell id="ret" value="returnWithInfo(): return {id, firstName, lastName, error: &amp;quot;&amp;quot;}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="540" y="640" width="210" height="60" as="geometry"/></mxCell><mxCell id="a7" value="saveCookie() with 20-minute expiry, then redirect to color.html" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="740" width="210" height="70" as="geometry"/></mxCell><mxCell id="a8" value="color.html loads: readCookie()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="290" y="850" width="210" height="60" as="geometry"/></mxCell><mxCell id="d2" value="userId &amp;gt;= 0?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="305" y="950" width="180" height="80" as="geometry"/><